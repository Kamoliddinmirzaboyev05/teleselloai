{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "env": {
    "NODE_VERSION": "22"
  },
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://13.60.104.64/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
