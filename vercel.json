{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd frontend-admin && npm ci",
  "buildCommand": "cd frontend-admin && npm run build",
  "env": {
    "NODE_VERSION": "22"
  },
  "outputDirectory": "frontend-admin/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
